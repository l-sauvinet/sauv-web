---
import SpeedStripes from './SpeedStripes.astro';

interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<section class="relative overflow-hidden border-b border-border">
  <SpeedStripes logo={false} class="pointer-events-none absolute inset-y-0 -right-16 hidden w-[24rem] opacity-50 md:block" />
  <div class="container-site relative py-10 sm:py-20">
    <p class="label-mono text-accent-text" data-reveal>{eyebrow}</p>
    <h1 class="mt-4 max-w-3xl text-[clamp(1.75rem,8vw,3.75rem)] leading-[1.02] italic sm:text-6xl" style="font-stretch: 125%; font-weight: 900; --reveal-delay: 60ms" data-reveal>
      {title}
    </h1>
    {intro && <p class="mt-6 max-w-2xl text-lg text-muted" data-reveal style="--reveal-delay: 120ms">{intro}</p>}
    <slot />
  </div>
</section>
