---
interface Props {
  eyebrow: string;
  title: string;
  id?: string;
  class?: string;
}

const { eyebrow, title, id, class: className = '' } = Astro.props;
---

<div class:list={['max-w-2xl', className]} data-reveal>
  <p class="label-mono text-accent-text">{eyebrow}</p>
  <h2 id={id} class="mt-3 text-3xl leading-tight italic sm:text-[2.6rem]" style="font-stretch: 118%; font-weight: 900">
    {title}
  </h2>
  <slot />
</div>
