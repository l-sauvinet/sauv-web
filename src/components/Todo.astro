---
interface Props {
  label: string;
  as?: 'p' | 'li';
}

const { label, as: Tag = 'p' } = Astro.props;
const visible = import.meta.env.DEV;
---

{
  visible && (
    <Tag class="my-4 list-none before:hidden rounded-md border-2 border-dashed border-amber-500 bg-amber-500/10 px-4 py-3 font-mono text-sm text-amber-700 dark:text-amber-300">
      TODO · {label}
    </Tag>
  )
}
