---
import SpeedStripes from './SpeedStripes.astro';
import { site, responseDelay } from '../data/site';

interface Props {
  title?: string;
  highlight?: string;
  text?: string;
}

const {
  title = 'Un projet en tête ?',
  highlight = 'Parlons-en.',
  text = `Décrivez-moi votre besoin en quelques lignes. Je vous réponds sous ${responseDelay} avec une première estimation, gratuite et sans engagement.`,
} = Astro.props;

const frenchSpacing = (text: string) => text.replace(/ ([?!:;])/g, '\u00A0$1');
---

<section class="relative overflow-hidden border-t border-border bg-bg-alt py-16 sm:py-24" aria-labelledby="cta-titre">
  <SpeedStripes logo={false} class="pointer-events-none absolute inset-y-0 -right-24 hidden w-[28rem] opacity-60 sm:-right-10 sm:block" />
  <div class="container-site relative">
    <div class="max-w-2xl" data-reveal>
      <h2 id="cta-titre" class="text-[clamp(1.9rem,8.6vw,3.75rem)] leading-[1.02] italic sm:text-6xl" style="font-stretch: 125%; font-weight: 900">
        {frenchSpacing(title)} <span class="text-accent-text">{frenchSpacing(highlight)}</span>
      </h2>
      <p class="mt-6 max-w-lg text-lg text-muted">{text}</p>
      <div class="mt-9 flex flex-col items-start gap-5 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-6">
        <a href="/contact/" class="slant-solid"><span>Demander un devis</span></a>
        <a href={`mailto:${site.email}`} class="btn-ghost">{site.email}</a>
      </div>
    </div>
  </div>
</section>
