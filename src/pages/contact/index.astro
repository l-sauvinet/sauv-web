---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { services } from '../../data/services';
import { site, contactEndpoint, responseDelay } from '../../data/site';

const projectTypes = [...services.map((service) => service.title), 'Autre / je ne sais pas encore'];
const budgets = ['Moins de 1 000 €', '1 000 à 3 000 €', '3 000 à 6 000 €', 'Plus de 6 000 €', 'Je ne sais pas encore'];

const field =
  'mt-2 w-full rounded-md border border-border bg-bg px-4 py-3 text-fg placeholder:text-muted/70 transition-colors focus:border-teal-500 focus:outline-none';
const label = 'text-sm font-semibold text-primary';
---

<BaseLayout
  crumbs={[{ label: 'Contact' }]}
  title="Contact et demande de devis"
  description={`Contactez Sauv'Web, développeur freelance à Chambéry, pour un devis gratuit : application web, mobile ou logiciel sur mesure. Réponse sous ${responseDelay}.`}
>
  <PageHeader
    eyebrow="Contact"
    title="Parlons de votre projet"
    intro={`Quelques lignes suffisent pour commencer. Je vous réponds sous ${responseDelay} avec une première estimation, gratuite et sans engagement.`}
  />

  <section class="py-16 sm:py-20">
    <div class="container-site grid gap-14 lg:grid-cols-[1.5fr_1fr] lg:gap-20">
      <form action={contactEndpoint} method="post" class="space-y-6" data-contact-form novalidate>
        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="nom" class={label}>Nom <span class="text-accent-text" aria-hidden="true">*</span></label>
            <input id="nom" name="nom" type="text" autocomplete="name" required maxlength="100" class={field} />
          </div>
          <div>
            <label for="email" class={label}>Email <span class="text-accent-text" aria-hidden="true">*</span></label>
            <input id="email" name="email" type="email" autocomplete="email" required maxlength="150" class={field} />
          </div>
        </div>

        <div>
          <label for="entreprise" class={label}>Entreprise <span class="font-normal text-muted">(facultatif)</span></label>
          <input id="entreprise" name="entreprise" type="text" autocomplete="organization" maxlength="120" class={field} />
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="type" class={label}>Type de projet</label>
            <select id="type" name="type" class={field}>
              {projectTypes.map((type) => <option>{type}</option>)}
            </select>
          </div>
          <div>
            <label for="budget" class={label}>Budget envisagé</label>
            <select id="budget" name="budget" class={field}>
              {budgets.map((budget) => <option selected={budget === 'Je ne sais pas encore'}>{budget}</option>)}
            </select>
          </div>
        </div>

        <div>
          <label for="message" class={label}>Votre projet <span class="text-accent-text" aria-hidden="true">*</span></label>
          <textarea
            id="message"
            name="message"
            rows="7"
            required
            minlength="20"
            maxlength="5000"
            placeholder="Ce que vous voulez faire, pour qui, et s'il y a une échéance."
            class={field}></textarea>
        </div>

        <div class="hp-field" aria-hidden="true">
          <label for="site_web">Ne pas remplir ce champ</label>
          <input id="site_web" name="site_web" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="ts" value="" data-ts />

        <p class="text-sm text-muted">
          Les champs marqués <span class="text-accent-text">*</span> sont obligatoires. Vos informations servent uniquement
          à répondre à votre demande. <a href="/confidentialite/" class="underline underline-offset-4 hover:text-primary">En savoir plus</a>.
        </p>

        <div class="flex flex-wrap items-center gap-6">
          <button type="submit" class="slant-solid cursor-pointer disabled:cursor-wait disabled:opacity-60" data-submit>
            <span>Envoyer ma demande</span>
          </button>
          <p class="text-sm font-semibold" role="status" aria-live="polite" data-status></p>
        </div>
      </form>

      <aside class="space-y-10 lg:pt-2">
        <div>
          <h2 class="label-mono text-accent-text">Par email</h2>
          <a href={`mailto:${site.email}`} class="mt-3 inline-block text-lg font-semibold text-primary underline decoration-teal-500/50 underline-offset-4 hover:decoration-teal-500">
            {site.email}
          </a>
        </div>
        <div>
          <h2 class="label-mono text-accent-text">Par téléphone</h2>
          <a href={`tel:${site.phoneIntl}`} class="mt-3 inline-block text-lg font-semibold text-primary underline decoration-teal-500/50 underline-offset-4 hover:decoration-teal-500">
            {site.phone}
          </a>
        </div>
        <div>
          <h2 class="label-mono text-accent-text">Basé à</h2>
          <p class="mt-3 text-lg text-primary">{site.address.city}, à côté de Chambéry (Savoie)</p>
          <p class="mt-1 text-muted">Rendez-vous possibles en Savoie, à distance partout en France.</p>
        </div>
        <div>
          <h2 class="label-mono text-accent-text">Et ensuite ?</h2>
          <ol class="mt-4 space-y-3 text-muted">
            <li><span class="font-semibold text-primary">1.</span> Je lis votre demande et vous réponds sous {responseDelay}.</li>
            <li><span class="font-semibold text-primary">2.</span> On échange pour préciser le besoin.</li>
            <li><span class="font-semibold text-primary">3.</span> Je vous envoie un devis gratuit et détaillé.</li>
          </ol>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  select option {
    background: var(--bg);
    color: var(--fg);
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('[data-status]');
  const submit = form?.querySelector<HTMLButtonElement>('[data-submit]');
  const timestamp = form?.querySelector<HTMLInputElement>('[data-ts]');

  if (timestamp) timestamp.value = String(Math.floor(Date.now() / 1000));

  const serverError = new URLSearchParams(window.location.search).get('erreur');

  const setStatus = (message: string, tone: 'ok' | 'error') => {
    if (!status) return;
    status.textContent = message;
    status.className = `text-sm font-semibold ${tone === 'ok' ? 'text-accent-text' : 'text-red-500'}`;
  };

  if (serverError) setStatus(`${serverError}.`, 'error');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    submit?.setAttribute('disabled', '');
    setStatus('Envoi en cours…', 'ok');

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      const result = (await response.json().catch(() => null)) as { ok?: boolean; error?: string } | null;
      if (!response.ok || !result?.ok) throw new Error(result?.error ?? 'Envoi impossible');
      form.reset();
      window.location.assign('/contact/merci/');
    } catch (error) {
      const reason = error instanceof Error ? error.message : 'Envoi impossible';
      setStatus(`${reason}. Vous pouvez aussi m'écrire directement à sauv.web@gmail.com.`, 'error');
      submit?.removeAttribute('disabled');
    }
  });
</script>
